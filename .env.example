# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RBAC_SESSION_SECRET: Kunci acak minimal 32 karakter agar sesi login tetap aktif saat server restart (wajib diisi di Railway/Production)
RBAC_SESSION_SECRET=""

# DATA_DIR: Opsional, lokasi folder penyimpanan User/Role & Riwayat Chat (default: /app/data — cocok untuk Railway Volume)
DATA_DIR=""

# Jalur A (Direkomendasikan untuk MySQL lokal + ngrok Free `ngrok http 3000`):
# Jalankan skrip lokal erp-mysql-bridge.mjs di PC/server MySQL, lalu isi 2 variabel ini di Secrets:
ERP_BRIDGE_URL=""
ERP_BRIDGE_TOKEN=""

# Jalur B (Alternatif Koneksi Langsung TCP MySQL — bila server MySQL punya IP publik / ngrok tcp):
# Simpan kredensial asli di panel Secrets / Environment Variables, bukan di kode.
ERP_MYSQL_HOST=""
ERP_MYSQL_PORT="3306"
ERP_MYSQL_DATABASE=""
ERP_MYSQL_USER=""
ERP_MYSQL_PASSWORD=""
# Set "true" jika server MySQL ERP mewajibkan koneksi SSL/TLS
ERP_MYSQL_SSL="false"
# Nama tabel atau SQL View khusus read-only stok barang
ERP_MYSQL_STOCK_VIEW="vw_ai_stok_barang"
# Pemetaan nama kolom opsional (biarkan kosong untuk deteksi otomatis dari View/Tabel)
ERP_MYSQL_COL_CODE=""
ERP_MYSQL_COL_NAME=""
ERP_MYSQL_COL_WAREHOUSE=""
ERP_MYSQL_COL_QTY=""
ERP_MYSQL_COL_UNIT=""
ERP_MYSQL_COL_CATEGORY=""

# ==============================================================================
# Pengiriman Notifikasi Otomatis (Email & WhatsApp) — Server-Side Secrets ONLY
# Isi salah satu penyedia Email dan/atau WhatsApp di panel Settings > Secrets.
# Jika belum diisi, sistem tetap menyimpan Notifikasi Khusus In-App dan
# menyediakan tautan kirim cepat 1-klik (mailto: & wa.me).
# ==============================================================================

# Email — Opsi 1: SMTP Kantor / Google Workspace / Microsoft 365 / Mailtrap
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SOP Brain Notification <no-reply@perusahaan.co.id>"

# Email — Opsi 2 (Alternatif HTTP API): Resend (https://resend.com)
RESEND_API_KEY=""

# WhatsApp — Pilih provider: "fonnte" (Fonnte.com) atau "meta" (WhatsApp Cloud API resmi)
WHATSAPP_PROVIDER=""
# Jika WHATSAPP_PROVIDER="fonnte":
FONNTE_TOKEN=""
# Jika WHATSAPP_PROVIDER="meta":
WHATSAPP_META_TOKEN=""
WHATSAPP_META_PHONE_NUMBER_ID=""

